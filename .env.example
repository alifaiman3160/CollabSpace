APP_NAME=CollabSpace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Every displayed time and every "which day is it" rule (daily message cap,
# overdue, per-day activity, reports) uses this zone. Stored times have no zone,
# so see docs/TIMEZONE.md before changing it on a database that already has data.
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#-------------------------------------------------------------------------
# Mail
#-------------------------------------------------------------------------
#
# CollabSpace sends three things: the account-created email carrying a new
# user's temporary password, the password reset link, and whatever
# `php artisan mail:test you@example.com` is asked to send. Nothing here is
# hardcoded anywhere in the application — config/mail.php reads every value
# below, so changing delivery means changing this file and nothing else.
#
# MAIL_MAILER
#   log   writes the whole email into storage/logs/laravel.log and sends
#         nothing over the network. The right default for development and
#         for a fresh clone: no credentials needed, and every email is still
#         inspectable. `mail:test` says plainly when you are on it.
#   smtp  real delivery. Fill in the four Gmail values below first.
#
MAIL_MAILER=log

# --- Gmail SMTP -----------------------------------------------------------
#
# To send for real: set MAIL_MAILER=smtp above and fill in MAIL_USERNAME and
# MAIL_PASSWORD below. The host, port and scheme are already correct for
# Gmail and do not need changing.
#
# MAIL_PASSWORD MUST BE A GOOGLE APP PASSWORD, NOT THE ACCOUNT PASSWORD.
#
#   Google has not accepted account passwords over SMTP since 2022 — a real
#   password fails with "Username and Password not accepted" no matter how
#   correct it is. An App Password is a separate 16-character code generated
#   per application, and it only works on an account with 2-Step
#   Verification switched on.
#
#   Generate one: Google Account → Security → 2-Step Verification (turn it
#   on if it is off) → App passwords → create one named "CollabSpace".
#   Google shows it once, as four groups of four letters. Paste it below
#   with or without the spaces; both work. Treat it as a password: it grants
#   send access to the account until revoked from that same screen.
#
# MAIL_PORT / MAIL_SCHEME — 587 with "smtp" is STARTTLS and is the pairing
#   to use. Gmail also accepts 465 with "smtps" (implicit TLS) if a network
#   blocks 587. The two must agree; a mismatch hangs until it times out.
#
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=

# The address recipients see. Gmail rewrites the envelope sender to the
# authenticated account regardless, so unless MAIL_FROM_ADDRESS is that same
# Gmail address (or an alias it is verified to send as), mail clients show
# the real account and may mark the message as suspicious. Simplest correct
# setting is the same address as MAIL_USERNAME.
MAIL_FROM_ADDRESS="no-reply@collabspace.test"
MAIL_FROM_NAME="${APP_NAME}"

# Optional. Some SMTP servers reject the EHLO name a local machine offers.
# Leave it unset unless a connection is refused during the handshake.
# MAIL_EHLO_DOMAIN=

# --- AI suggestions (optional) ------------------------------------------------
#
# Used only for the optional mark suggestions lecturers can request. With
# AI_DRIVER=none (the default), or a key missing, everything still works: the
# rule-based suggestion is shown and the page says AI suggestions are off.
#
# Keys live here and nowhere else. They are never written to the database or a
# log, and never sent to the browser. Run `php artisan ai:ping` after editing to
# check the provider answers; it prints the provider, model and response time,
# and never the key.
#
# AI_DRIVER   none | anthropic | openai | gemini | openai_compatible
#             or a preset: openrouter | groq | ollama
AI_DRIVER=none

# Requests each lecturer may make per day, across all screens. 0 = none.
AI_DAILY_LIMIT=200

# anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT=30
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
# OPENAI_BASE_URL=https://api.openai.com/v1

# gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=30
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# openai_compatible, openrouter, groq, ollama: any server that speaks the OpenAI
# chat API. The presets fill in their usual address if AI_COMPAT_BASE_URL is empty
# (openrouter https://openrouter.ai/api/v1, groq https://api.groq.com/openai/v1,
# ollama http://localhost:11434/v1). A local Ollama needs no key.
AI_COMPAT_BASE_URL=
AI_COMPAT_API_KEY=
AI_COMPAT_MODEL=
AI_COMPAT_TIMEOUT=60
# Set to false for a self-hosted server that does not check keys.
AI_COMPAT_KEY_REQUIRED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
